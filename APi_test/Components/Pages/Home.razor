@page "/statistics"
@using Services
@using Blazorise.Charts
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage Storage

<div class="statistics-page">
    <div class="page-header">
        <h1>Statistics Dashboard</h1>
        <p class="page-subtitle">Visual overview of your music collection</p>
    </div>

    <div class="search-row" style="margin-bottom:16px; display:flex; gap:8px; align-items:center;">
        <label style="font-weight:600;">Username:</label>
        <input @bind="searchUsername" placeholder="Enter username to search" />
        <button @onclick="SearchByUsername">Search</button>
        <span class="status">@status</span>
    </div>

    @if (isLoading)
    {
        <div class="loading-message">
            <p>Loading statistics...</p>
        </div>
    }
    else
    {
        @* Total Genres Chart *@
        <div class="chart-section">
            <h3>Total Songs by Genre</h3>
            <div class="chart-container">
                <BarChart @ref="totalGenresChart" TItem="int" />
            </div>
        </div>

        @* Genres Per Playlist Chart *@
        <div class="chart-section">
            <h3>Genres Distribution Across Playlists</h3>

            @* Playlist selector *@
            <div class="playlist-selector">
                <label>Select Playlist:</label>
                <select @bind="selectedPlaylistId" @bind:after="UpdatePlaylistChart">
                    <option value="-1">-- All Playlists --</option>
                    @foreach (var playlist in playlistNames)
                    {
                        <option value="@playlist.Key">@playlist.Value</option>
                    }
                </select>
            </div>

            <div class="chart-container">
                <BarChart @ref="playlistGenresChart" TItem="int" />
            </div>
        </div>

        @* Raw Data Table *@
        <div class="data-section">
            <h3>Raw Data</h3>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Playlist</th>
                        <th>Genre</th>
                        <th>Count</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stat in allStats)
                    {
                        <tr>
                            <td>@stat.playlistName</td>
                            <td>@stat.genre</td>
                            <td>@stat.count</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .statistics-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .page-header {
        margin-bottom: 40px;
    }

        .page-header h1 {
            font-size: 32px;
            color: #2c3e50;
            margin: 0 0 8px 0;
            font-weight: 700;
        }

    .page-subtitle {
        color: #7f8c8d;
        font-size: 16px;
        margin: 0;
    }

    .chart-section {
        background: white;
        padding: 30px;
        border-radius: 12px;
        margin-bottom: 30px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        border: 1px solid #f0f0f0;
    }

        .chart-section h3 {
            margin: 0 0 20px 0;
            color: #2c3e50;
            font-size: 20px;
            font-weight: 600;
        }

    .chart-container {
        height: 400px;
        position: relative;
    }

    .playlist-selector {
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .playlist-selector label {
            font-weight: 600;
            color: #2c3e50;
        }

        .playlist-selector select {
            padding: 8px 12px;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
            background: white;
        }

            .playlist-selector select:focus {
                outline: none;
                border-color: #667eea;
            }

    .data-section {
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        border: 1px solid #f0f0f0;
    }

        .data-section h3 {
            margin: 0 0 20px 0;
            color: #2c3e50;
            font-size: 20px;
            font-weight: 600;
        }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table thead {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .data-table th {
            padding: 12px;
            text-align: left;
            font-weight: 600;
            font-size: 14px;
        }

        .data-table td {
            padding: 12px;
            border-bottom: 1px solid #f0f0f0;
            color: #2c3e50;
            font-size: 14px;
        }

        .data-table tbody tr:hover {
            background: #f8f9fa;
        }

    .alert {
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 20px;
    }

    .alert-warning {
        background: #fff3cd;
        border-left: 4px solid #ffc107;
        color: #856404;
    }

    .loading-message {
        text-align: center;
        padding: 40px;
        color: #7f8c8d;
    }
</style>

@code {
    // Service for calling the API
    private StatisticsService statsService = new StatisticsService();

    // Current logged-in user (optional)
    private Models.User user = null;

    // Search and status
    private string searchUsername = "";
    private string status = "";

    // Loading state
    private bool isLoading = false;

    // Chart references
    private BarChart<int> totalGenresChart;
    private BarChart<int> playlistGenresChart;

    // Data from API
    private List<GenrePlaylistStat> allStats = new List<GenrePlaylistStat>();
    private Dictionary<string, int> totalGenres = new Dictionary<string, int>();

    // Playlist selection
    private Dictionary<int, string> playlistNames = new Dictionary<int, string>();
    private int selectedPlaylistId = -1;

    // Called after component renders
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender == false)
        {
            return;
        }

        // Try to prefill username from stored user (optional)
        var result = await Storage.GetAsync<Models.User>("user");
        if (result.Success)
        {
            user = result.Value;
            if (string.IsNullOrWhiteSpace(searchUsername))
            {
                searchUsername = user.username;
                // auto-load for logged-in user
                await PerformSearchAndRender(searchUsername);
            }
        }
        else
        {
            user = null;
        }

        StateHasChanged();
    }

    // Called when user clicks Search
    private async Task SearchByUsername()
    {
        if (string.IsNullOrWhiteSpace(searchUsername))
        {
            status = "Enter a username to search.";
            return;
        }

        await PerformSearchAndRender(searchUsername);
    }

    // Load statistics for given username and draw charts
    private async Task PerformSearchAndRender(string username)
    {
        isLoading = true;
        status = "Loading...";
        allStats.Clear();
        totalGenres.Clear();
        playlistNames.Clear();
        selectedPlaylistId = -1;

        StateHasChanged();

        try
        {
            // Get all stats from API for provided username
            allStats = await statsService.GetGenresPerPlaylistAsync(username);

            // Get total genres
            totalGenres = await statsService.GetTotalGenresAsync(username);

            // Extract unique playlist names
            for (int i = 0; i < allStats.Count; i = i + 1)
            {
                int playlistId = allStats[i].playlistId;
                string playlistName = allStats[i].playlistName;

                if (playlistNames.ContainsKey(playlistId) == false)
                {
                    playlistNames.Add(playlistId, playlistName);
                }
            }

            // Draw charts
            await DrawTotalGenresChart();
            await DrawPlaylistGenresChart();

            status = "Loaded " + allStats.Count.ToString() + " records";
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading statistics: " + ex.Message);
            status = "Error loading statistics";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // Draw the total genres chart
    private async Task DrawTotalGenresChart()
    {
        if (totalGenresChart == null)
        {
            return;
        }

        await totalGenresChart.Clear();

        // Convert dictionary to arrays for the chart
        List<string> labels = new List<string>();
        List<int> data = new List<int>();

        foreach (var kvp in totalGenres)
        {
            labels.Add(kvp.Key);
            data.Add(kvp.Value);
        }

        // Create the dataset
        await totalGenresChart.AddLabelsDatasetsAndUpdate(
            labels.ToArray(),
            GetBarChartDataset("Songs", data, "#667eea")
        );
    }

    // Draw the playlist genres chart
    private async Task DrawPlaylistGenresChart()
    {
        if (playlistGenresChart == null)
        {
            return;
        }

        await playlistGenresChart.Clear();

        // Filter data by selected playlist
        List<GenrePlaylistStat> filteredStats = new List<GenrePlaylistStat>();

        if (selectedPlaylistId == -1)
        {
            // Show all playlists
            filteredStats = allStats;
        }
        else
        {
            // Filter by selected playlist
            for (int i = 0; i < allStats.Count; i = i + 1)
            {
                if (allStats[i].playlistId == selectedPlaylistId)
                {
                    filteredStats.Add(allStats[i]);
                }
            }
        }

        // Extract labels and data
        List<string> labels = new List<string>();
        List<int> data = new List<int>();

        for (int i = 0; i < filteredStats.Count; i = i + 1)
        {
            labels.Add(filteredStats[i].genre);
            data.Add(filteredStats[i].count);
        }

        // Create the dataset
        await playlistGenresChart.AddLabelsDatasetsAndUpdate(
            labels.ToArray(),
            GetBarChartDataset("Songs", data, "#764ba2")
        );
    }

    // Update playlist chart when selection changes
    private async Task UpdatePlaylistChart()
    {
        await DrawPlaylistGenresChart();
    }

    // Helper method to create a bar chart dataset
    private BarChartDataset<int> GetBarChartDataset(string label, List<int> data, string color)
    {
        return new BarChartDataset<int>
        {
            Label = label,
            Data = data,
            BackgroundColor = new List<string> { color },
            BorderColor = new List<string> { color },
            BorderWidth = 2
        };
    }
}