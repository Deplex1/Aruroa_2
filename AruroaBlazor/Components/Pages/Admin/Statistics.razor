@page "/adminDashboard/statistics"

@using Models
@using Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using System.Net.Http
@using System.Text.Json
@using ApexCharts
@inject ProtectedSessionStorage Storage
@inject NavigationManager Nav
@inject IHttpClientFactory HttpClientFactory

<h1>📊 System Statistics</h1>

@if (user == null)
{
    <p>You must be logged in to view this page.</p>
}
else if (user.IsAdmin == 0)
{
    <p>You are not an admin.</p>
}
else
{
    <div style="margin-bottom: 20px;">
        <button class="btn btn-secondary" @onclick="GoBack">← Back to Dashboard</button>
        <button class="btn btn-primary" @onclick="LoadStatistics" style="margin-left: 10px;">🔄 Refresh</button>
    </div>

    @if (isLoading)
    {
        <p>Loading statistics...</p>
    }
    else if (stats != null)
    {
        <div class="row">
            <div class="col-md-3">
                <div class="card text-white bg-primary mb-3">
                    <div class="card-body">
                        <h5 class="card-title">👥 Total Users</h5>
                        <h2>@stats.TotalUsers</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-success mb-3">
                    <div class="card-body">
                        <h5 class="card-title">🎵 Total Songs</h5>
                        <h2>@stats.TotalSongs</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-info mb-3">
                    <div class="card-body">
                        <h5 class="card-title">📝 Total Playlists</h5>
                        <h2>@stats.TotalPlaylists</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-warning mb-3">
                    <div class="card-body">
                        <h5 class="card-title">▶️ Total Plays</h5>
                        <h2>@stats.TotalPlays</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5>📊 Platform Overview</h5>
                    </div>
                    <div class="card-body">
                        <ApexChart TItem="StatItem"
                                   Title="Platform Statistics"
                                   Options="pieOptions">
                            <ApexPointSeries TItem="StatItem"
                                           Items="pieData"
                                           Name="Count"
                                           SeriesType="SeriesType.Pie"
                                           XValue="@(e => e.Label)"
                                           YAggregate="@(e => e.Sum(e => e.Value))" />
                        </ApexChart>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5>📈 Engagement Metrics</h5>
                    </div>
                    <div class="card-body">
                        <ApexChart TItem="StatItem"
                                   Title="Average Metrics"
                                   Options="barOptions">
                            <ApexPointSeries TItem="StatItem"
                                           Items="barData"
                                           Name="Average"
                                           SeriesType="SeriesType.Bar"
                                           XValue="@(e => e.Label)"
                                           YAggregate="@(e => e.Sum(e => e.Value))"
                                           OrderBy="e => e.X" />
                        </ApexChart>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h5>📋 Detailed Statistics</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-striped">
                            <tbody>
                                <tr>
                                    <td><strong>Average Songs per User</strong></td>
                                    <td>@GetAverageSongsPerUser()</td>
                                </tr>
                                <tr>
                                    <td><strong>Average Playlists per User</strong></td>
                                    <td>@GetAveragePlaylistsPerUser()</td>
                                </tr>
                                <tr>
                                    <td><strong>Average Plays per Song</strong></td>
                                    <td>@GetAveragePlaysPerSong()</td>
                                </tr>
                                <tr>
                                    <td><strong>Total Content Items</strong></td>
                                    <td>@(stats.TotalSongs + stats.TotalPlaylists)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger">
            <strong>Error:</strong> @errorMessage
        </div>
    }
}

@code {
    private User user = null;
    private SiteStats stats = null;
    private bool isLoading = false;
    private string errorMessage = null;

    // Chart data
    private List<StatItem> pieData = new List<StatItem>();
    private List<StatItem> barData = new List<StatItem>();

    // Chart options
    private ApexChartOptions<StatItem> pieOptions = new ApexChartOptions<StatItem>
    {
        Legend = new Legend
        {
            Position = LegendPosition.Bottom
        },
        Colors = new List<string> { "#007bff", "#28a745", "#17a2b8", "#ffc107" }
    };

    private ApexChartOptions<StatItem> barOptions = new ApexChartOptions<StatItem>
    {
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar
            {
                Horizontal = false,
                DataLabels = new PlotOptionsBarDataLabels
                {
                    Position = BarDataLabelPosition.Top
                }
            }
        },
        Colors = new List<string> { "#6c757d" },
        DataLabels = new DataLabels
        {
            Enabled = true,
            OffsetY = -20,
            Style = new DataLabelsStyle
            {
                FontSize = "12px",
                Colors = new List<string> { "#304758" }
            }
        }
    };

    // Helper class for chart data
    public class StatItem
    {
        public string Label { get; set; }
        public decimal Value { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first) return;

        var result = await Storage.GetAsync<User>("user");

        if (result.Success)
        {
            user = result.Value;
            await LoadStatistics();
        }
        else
        {
            user = null;
        }

        StateHasChanged();
    }

    private async Task LoadStatistics()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var httpClient = HttpClientFactory.CreateClient();
            var response = await httpClient.GetAsync("http://localhost:5230/api/Statistics/system");

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                stats = JsonSerializer.Deserialize<SiteStats>(json, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

                // Prepare chart data
                PrepareChartData();
            }
            else
            {
                errorMessage = $"Failed to load statistics: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading statistics: {ex.Message}";
            Console.WriteLine("Error loading statistics: " + ex.Message);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void PrepareChartData()
    {
        if (stats == null) return;

        // Pie chart data - Platform overview
        pieData = new List<StatItem>
        {
            new StatItem { Label = "Users", Value = stats.TotalUsers },
            new StatItem { Label = "Songs", Value = stats.TotalSongs },
            new StatItem { Label = "Playlists", Value = stats.TotalPlaylists },
            new StatItem { Label = "Plays (÷100)", Value = stats.TotalPlays / 100 } // Scale down for visibility
        };

        // Bar chart data - Averages
        barData = new List<StatItem>
        {
            new StatItem { Label = "Songs/User", Value = decimal.Parse(GetAverageSongsPerUser()) },
            new StatItem { Label = "Playlists/User", Value = decimal.Parse(GetAveragePlaylistsPerUser()) },
            new StatItem { Label = "Plays/Song", Value = decimal.Parse(GetAveragePlaysPerSong()) }
        };
    }

    private string GetAverageSongsPerUser()
    {
        if (stats == null || stats.TotalUsers == 0)
            return "0.00";
        
        double avg = (double)stats.TotalSongs / stats.TotalUsers;
        return avg.ToString("F2");
    }

    private string GetAveragePlaylistsPerUser()
    {
        if (stats == null || stats.TotalUsers == 0)
            return "0.00";
        
        double avg = (double)stats.TotalPlaylists / stats.TotalUsers;
        return avg.ToString("F2");
    }

    private string GetAveragePlaysPerSong()
    {
        if (stats == null || stats.TotalSongs == 0)
            return "0.00";
        
        double avg = (double)stats.TotalPlays / stats.TotalSongs;
        return avg.ToString("F2");
    }

    private void GoBack()
    {
        Nav.NavigateTo("/adminDashboard");
    }
}
