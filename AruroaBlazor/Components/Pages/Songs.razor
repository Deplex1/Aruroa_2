@page "/songs"
@using Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Services
@using DBL

@inject NavigationManager Nav
@inject ProtectedSessionStorage Storage
@implements IDisposable

<link href="~/song.css?v=3" rel="stylesheet" />

<div class="songs-page-wrapper" @onclick="HideContextMenu">
    <div class="songs-main-section">
        <div class="page-header">
            <h1>Songs</h1>
        </div>

        <div class="search-section">
            <input placeholder="Search songs..." @bind="searchText" @oninput="OnSearchInput" class="search-input" />
            <button @onclick="Search" class="btn-search">Search</button>
            <button @onclick="ClearSearch" class="btn-clear">Clear</button>
        </div>

        <div class="genre-filter-section">
            <h4>Filter by Genre:</h4>
            
            @* Search bar for filtering genre names *@
            <div class="genre-search-bar">
                <input type="text" 
                       placeholder="Search genres..." 
                       @bind="genreSearchText" 
                       @oninput="OnGenreSearchInput" 
                       class="genre-search-input" />
            </div>

            @* Active filters display *@
            @if (selectedFilterGenreIds.Count > 0)
            {
                <div class="active-filters">
                    <span class="active-filters-label">Active Filters:</span>
                    @for (int i = 0; i < selectedFilterGenreIds.Count; i = i + 1)
                    {
                        int genreId = selectedFilterGenreIds[i];
                        string genreName = GetGenreNameById(genreId);
                        
                        <button class="filter-tag active" @onclick="() => RemoveGenreFilter(genreId)">
                            @genreName ✕
                        </button>
                    }
                    <button @onclick="ClearGenreFilter" class="btn-clear-all">Clear All</button>
                </div>
            }

            @* Available genres as clickable tags *@
            <div class="genre-tags-container">
                @for (int i = 0; i < filteredGenres.Count; i = i + 1)
                {
                    Genre genre = filteredGenres[i];
                    bool isSelected = IsGenreFilterSelected(genre.genreid);
                    string tagClass = isSelected ? "filter-tag selected" : "filter-tag";
                    
                    <button class="@tagClass" @onclick="() => ToggleGenreFilterClick(genre.genreid)">
                        @genre.name
                    </button>
                }
            </div>
        </div>

        <hr class="divider" />

        @if (songList == null)
        {
            <p class="loading-message">Loading songs...</p>
        }
        else if (songList.Count == 0)
        {
            <p class="no-songs-message">No songs found.</p>
        }
        else
        {
            @for (int i = 0; i < songList.Count; i++)
            {
                Song song = songList[i];

                double avgRating = 0;
                int ratingCount = 0;
                if (ratingStats.ContainsKey(song.songID))
                {
                    avgRating = ratingStats[song.songID].average;
                    ratingCount = ratingStats[song.songID].count;
                }

                <div class="song-card @GetSongCardClass(song.songID)">
                    <h3 @oncontextmenu="(e) => ShowContextMenu(e, song.songID)" 
                        @oncontextmenu:preventDefault="true"
                        class="song-title-contextmenu">
                        @song.title
                    </h3>

                    @if (songGenres.ContainsKey(song.songID))
                    {
                        <div class="genre-tags">
                            @foreach (Genre genre in songGenres[song.songID])
                            {
                                <span class="genre-tag">@genre.name</span>
                            }
                        </div>
                    }

                    <p class="song-info">
                        Duration: @uiHelper.FormatDuration(song.duration) |
                        Plays: @song.plays |
                        Avg: @uiHelper.FormatRating(avgRating) (@ratingCount ratings)
                    </p>

                    @if (song.audioData != null)
                    {
                        <div class="action-buttons">
                            <button class="play-now-btn" @onclick="() => PlayNow(song)">▶ Play Now</button>
                            <button class="add-to-queue-btn" @onclick="() => AddToQueue(song)">+ Add to Queue</button>
                        </div>
                    }

                    @* Context Menu for Add to Playlist *@
                    @if (contextMenuVisible && contextMenuSongId == song.songID)
                    {
                        <div class="context-menu" 
                             style="top: @(contextMenuY)px; left: @(contextMenuX)px;"
                             @onclick:stopPropagation="true">
                            <div class="context-menu-header">Add to Playlist</div>
                            
                            @if (currentUser == null)
                            {
                                <div class="context-menu-item-disabled">Please login first</div>
                            }
                            else if (availablePlaylistsForSong.Count == 0)
                            {
                                <div class="context-menu-item-disabled">No available playlists</div>
                            }
                            else
                            {
                                @for (int p = 0; p < availablePlaylistsForSong.Count; p = p + 1)
                                {
                                    Playlist playlist = availablePlaylistsForSong[p];
                                    
                                    <button class="context-menu-item"
                                            @onclick="() => AddSongToPlaylistFromContext(song.songID, playlist.playlistid)">
                                        @playlist.name
                                    </button>
                                }
                            }
                        </div>
                    }

                    <div class="stars">
                        @for (int s = 1; s <= 5; s++)
                        {
                            int currentStar = s;
                            string starClass = GetStarClass(song.songID, currentStar);

                            <span class="star @starClass"
                                  @onmouseover="() => OnHover(song.songID, currentStar)"
                                  @onmouseout="() => OnHover(song.songID, 0)"
                                  @onclick="() => OnClick(song.songID, currentStar)">
                                ★
                            </span>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@code
{
    private SongService songService = new SongService();
    private UIHelperService uiHelper = new UIHelperService();

    private List<Song> songList = new List<Song>();
    private Dictionary<int, (double average, int count)> ratingStats = new();
    private Dictionary<int, List<Genre>> songGenres = new();
    private List<Genre> availableGenres = new();
    private List<Genre> filteredGenres = new();
    private List<int> selectedFilterGenreIds = new();

    private string searchText = "";
    private string genreSearchText = "";
    private User? currentUser;

    private Dictionary<int, int> userRatings = new();
    private Dictionary<int, int> previewRatings = new();

    private int currentlyPlayingSongId = -1;

    // Context menu for add to playlist
    private bool contextMenuVisible = false;
    private int contextMenuSongId = -1;
    private double contextMenuX = 0;
    private double contextMenuY = 0;
    private List<Playlist> userPlaylists = new List<Playlist>();
    private List<Playlist> availablePlaylistsForSong = new List<Playlist>();

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
        {
            await LoadCurrentUser();
            await LoadAllSongs();

            GlobalAudioPlayerService.OnStateChanged += OnPlayerStateChanged;
            StateHasChanged();
        }
    }

    private void OnPlayerStateChanged()
    {
        InvokeAsync(() =>
        {
            Song? currentSong = GlobalAudioPlayerService.GetCurrentSong();
            currentlyPlayingSongId = currentSong != null ? currentSong.songID : -1;
            StateHasChanged();
        });
    }

    private async Task LoadCurrentUser()
    {
        var result = await Storage.GetAsync<User>("user");
        currentUser = result.Success ? result.Value : null;
    }

    private async Task LoadAllSongs()
    {
        songList = await songService.LoadAllSongsAsync();
        ratingStats = await songService.GetRatingStatsForSongsAsync(songList);
        songGenres = await songService.LoadSongGenresAsync(songList);

        GenreDB genreDB = new GenreDB();
        availableGenres = await genreDB.SelectAllGenresAsync();
        filteredGenres = availableGenres;

        if (currentUser != null)
        {
            userRatings = await songService.LoadUserRatingsAsync(currentUser.userid);
            await LoadUserPlaylists();
        }
    }

    // Load user's playlists
    private async Task LoadUserPlaylists()
    {
        if (currentUser == null)
        {
            return;
        }

        try
        {
            PlaylistService playlistService = new PlaylistService();
            userPlaylists = await playlistService.LoadUserPlaylistsAsync(currentUser.userid);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading playlists: " + ex.Message);
            userPlaylists = new List<Playlist>();
        }
    }

    // Show context menu on right-click
    private async Task ShowContextMenu(MouseEventArgs e, int songId)
    {
        contextMenuVisible = true;
        contextMenuSongId = songId;
        contextMenuX = e.ClientX;
        contextMenuY = e.ClientY;

        // Filter playlists to only show ones that don't already have this song
        await FilterAvailablePlaylists(songId);

        StateHasChanged();
    }

    // Hide context menu
    private void HideContextMenu()
    {
        contextMenuVisible = false;
        contextMenuSongId = -1;
        StateHasChanged();
    }

    // Filter playlists to only show ones that don't have this song
    private async Task FilterAvailablePlaylists(int songId)
    {
        availablePlaylistsForSong = new List<Playlist>();

        if (currentUser == null)
        {
            return;
        }

        PlaylistSongDB playlistSongDB = new PlaylistSongDB();

        for (int i = 0; i < userPlaylists.Count; i = i + 1)
        {
            Playlist playlist = userPlaylists[i];
            
            // Check if song already exists in this playlist
            bool exists = await playlistSongDB.SongExistsInPlaylistAsync(playlist.playlistid, songId);
            
            if (exists == false)
            {
                availablePlaylistsForSong.Add(playlist);
            }
        }
    }

    // Add song to playlist from context menu
    private async Task AddSongToPlaylistFromContext(int songId, int playlistId)
    {
        try
        {
            PlaylistSongDB playlistSongDB = new PlaylistSongDB();

            // Get the next position (max position + 1)
            int maxPosition = await playlistSongDB.GetMaxPositionInPlaylistAsync(playlistId);
            int newPosition = maxPosition + 1;

            // Add song to playlist
            int result = await playlistSongDB.AddSongToPlaylistAsync(playlistId, songId, newPosition);

            if (result > 0)
            {
                Console.WriteLine("Song added to playlist successfully");
            }
            else
            {
                Console.WriteLine("Failed to add song to playlist");
            }

            // Hide context menu
            HideContextMenu();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error adding song to playlist: " + ex.Message);
        }
    }

    private async Task Search()
    {
        // Apply both search text AND genre filters together
        await ApplyFilters();
    }

    private async Task OnClick(int songId, int value)
    {
        if (currentUser == null) return;

        bool success = await songService.SaveRatingAsync(currentUser.userid, songId, value);

        if (success)
        {
            userRatings[songId] = value;
            ratingStats = await songService.GetRatingStatsForSongsAsync(songList);
            StateHasChanged();
        }
    }

    private void OnHover(int songId, int value)
    {
        if (value > 0)
        {
            previewRatings[songId] = value;
        }
        else
        {
            previewRatings.Remove(songId);
        }
    }

    string GetStarClass(int songId, int starIndex)
    {
        if (previewRatings.ContainsKey(songId))
        {
            return starIndex <= previewRatings[songId] ? "filled" : "gray";
        }

        if (userRatings.ContainsKey(songId))
        {
            return starIndex <= userRatings[songId] ? "filled" : "gray";
        }

        return "gray";
    }

    private async Task PlayNow(Song song)
    {
        GlobalAudioPlayerService.PlayNow(song);
        await songService.IncrementPlayCountAsync(song.songID);
    }

    private void AddToQueue(Song song)
    {
        GlobalAudioPlayerService.AddToQueue(song);
    }

    private string GetSongCardClass(int songId)
    {
        return songId == currentlyPlayingSongId ? "currently-playing" : "";
    }

    public void Dispose()
    {
        GlobalAudioPlayerService.OnStateChanged -= OnPlayerStateChanged;
    }

    // Called when user types in the search box
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        if (e.Value != null)
        {
            searchText = e.Value.ToString();
        }
        else
        {
            searchText = "";
        }

        // If user cleared the search box, reapply filters
        if (string.IsNullOrWhiteSpace(searchText))
        {
            await ApplyFilters();
            StateHasChanged();
        }
    }


    // Clear search button
    private async Task ClearSearch()
    {
        searchText = "";
        await ApplyFilters();
        StateHasChanged();
    }

    // Check if a genre is selected in the filter
    private bool IsGenreFilterSelected(int genreId)
    {
        for (int i = 0; i < selectedFilterGenreIds.Count; i = i + 1)
        {
            if (selectedFilterGenreIds[i] == genreId)
            {
                return true;
            }
        }

        return false;
    }

    // When user clicks on a genre tag to toggle it
    private async Task ToggleGenreFilterClick(int genreId)
    {
        bool isSelected = IsGenreFilterSelected(genreId);

        if (isSelected == true)
        {
            // Remove from filter
            for (int i = 0; i < selectedFilterGenreIds.Count; i = i + 1)
            {
                if (selectedFilterGenreIds[i] == genreId)
                {
                    selectedFilterGenreIds.RemoveAt(i);
                    break;
                }
            }
        }
        else
        {
            // Add to filter
            selectedFilterGenreIds.Add(genreId);
        }

        // Apply filter immediately when clicking
        await ApplyGenreFilter();
    }

    // Remove a specific genre from active filters
    private async Task RemoveGenreFilter(int genreId)
    {
        for (int i = 0; i < selectedFilterGenreIds.Count; i = i + 1)
        {
            if (selectedFilterGenreIds[i] == genreId)
            {
                selectedFilterGenreIds.RemoveAt(i);
                break;
            }
        }

        await ApplyGenreFilter();
    }

    // Get genre name by ID for display
    private string GetGenreNameById(int genreId)
    {
        for (int i = 0; i < availableGenres.Count; i = i + 1)
        {
            if (availableGenres[i].genreid == genreId)
            {
                return availableGenres[i].name;
            }
        }

        return "";
    }

    // Filter genres based on search text
    private void OnGenreSearchInput(ChangeEventArgs e)
    {
        if (e.Value != null)
        {
            genreSearchText = e.Value.ToString();
        }
        else
        {
            genreSearchText = "";
        }

        // Filter the available genres list
        if (string.IsNullOrWhiteSpace(genreSearchText))
        {
            filteredGenres = availableGenres;
        }
        else
        {
            filteredGenres = new List<Genre>();
            string searchLower = genreSearchText.ToLower();

            for (int i = 0; i < availableGenres.Count; i = i + 1)
            {
                string genreNameLower = availableGenres[i].name.ToLower();
                if (genreNameLower.Contains(searchLower))
                {
                    filteredGenres.Add(availableGenres[i]);
                }
            }
        }

        StateHasChanged();
    }

    // Apply genre filter - uses SQL to filter songs
    private async Task ApplyGenreFilter()
    {
        // Apply both search text AND genre filters together
        await ApplyFilters();
    }

    // Clear all genre filters
    private async Task ClearGenreFilter()
    {
        selectedFilterGenreIds.Clear();
        await ApplyFilters();
        StateHasChanged();
    }

    // Combined method that applies BOTH search text AND genre filters
    // This ensures AND logic - songs must match search text AND have all selected genres
    private async Task ApplyFilters()
    {
        // Start with all songs or filtered by genres
        if (selectedFilterGenreIds.Count == 0)
        {
            // No genre filter - just search
            if (string.IsNullOrWhiteSpace(searchText))
            {
                songList = await songService.LoadAllSongsAsync();
            }
            else
            {
                songList = await songService.SearchSongsAsync(searchText.Trim());
            }
        }
        else
        {
            // Apply genre filter first (with AND logic)
            songList = await songService.FilterSongsByGenresAsync(selectedFilterGenreIds);

            // Then filter by search text in C# if search text exists
            if (string.IsNullOrWhiteSpace(searchText) == false)
            {
                List<Song> searchFiltered = new List<Song>();
                string searchLower = searchText.Trim().ToLower();

                for (int i = 0; i < songList.Count; i = i + 1)
                {
                    string titleLower = songList[i].title.ToLower();
                    if (titleLower.Contains(searchLower))
                    {
                        searchFiltered.Add(songList[i]);
                    }
                }

                songList = searchFiltered;
            }
        }

        ratingStats = await songService.GetRatingStatsForSongsAsync(songList);
        songGenres = await songService.LoadSongGenresAsync(songList);
        StateHasChanged();
    }
}
